<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gunpack-bridge</AssemblyName>
    <RootNamespace>GunpackBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CodeWalker.Core built by scripts/build-bridge.mjs from a pinned commit (see CODEWALKER_COMMIT there). -->
    <CodeWalkerRuntime Condition="'$(CodeWalkerRuntime)' == ''">$(MSBuildThisFileDirectory).codewalker/runtime/</CodeWalkerRuntime>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compile-time only. CodeWalker's source is "released for educational purposes only", so it is
      never shipped with this app: at runtime CodeWalker.Core.dll (and its SharpDX dependencies) are
      loaded from the user's own CodeWalker folder (see CodeWalkerLoader).
    -->
    <Reference Include="CodeWalker.Core">
      <HintPath>$(CodeWalkerRuntime)CodeWalker.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
